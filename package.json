{
  "name": "siteguard",
  "version": "1.0.0",
  "private": true,
  "description": "Multi-tenant website monitoring SaaS for web agencies",
  "packageManager": "npm@10.9.8",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "NODE_ENV=test tsx --test tests/**/*.test.ts",
    "db:generate": "npm run --workspace=@siteguard/database generate",
    "db:push": "npm run --workspace=@siteguard/database push",
    "db:seed": "npm run --workspace=@siteguard/database seed",
    "start:api": "npm run --workspace=@siteguard/api start",
    "start:web": "npm run --workspace=@siteguard/web start",
    "dev:web": "npm run --workspace=@siteguard/web dev",
    "start:worker": "npm run --workspace=@siteguard/worker start"
  },
  "devDependencies": {
    "playwright-core": "^1.64.1",
    "turbo": "^2.4.4",
    "typescript": "^5.7.3"
  }
}
